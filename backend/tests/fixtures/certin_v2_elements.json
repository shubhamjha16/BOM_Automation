        "clause": "3.3.2.4",
        "phase": "progress",
        "title": "Preparation of SBOM"
      },
      {
        "clause": "3.3.2.5",
        "phase": "progress",
        "title": "Integrate SBOM in each phase of Secure Software Development Lifecycle (SSDLC)"
      },
      {
        "clause": "3.3.2.6",
        "phase": "progress",
        "title": "Establish secure configuration management"
