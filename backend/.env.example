# Required — the app refuses to import without these, naming the missing one.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
JWT_SECRET=

# Infrastructure
DATABASE_URL=postgresql+asyncpg://bom:bom@localhost:5432/bom_automation
REDIS_URL=redis://localhost:6379/0
PORT=8005
CORS_ORIGINS=http://localhost:5173
SENTRY_DSN=

# Models
ROUTER_MODEL=llama-3.3-70b-versatile
DRAFTER_MODEL=claude-sonnet-4-5

# Storage — BOMs are architecture disclosures: presigned only, SSE-KMS, per-client keys
S3_BUCKET=
AWS_REGION=ap-south-1
KMS_KEY_ID=
PRESIGN_TTL_SECONDS=900
MAX_BOM_MB=100

# Guideline pinning — every clause reference resolves against this version
GUIDELINE_VERSION=2.0
GUIDELINE_DATE=2025-07-09

# Lanes and scoring
ENABLED_LANES=sbom,aibom,cbom,qbom,hbom
JOBS_INLINE=false
PASS_THRESHOLD=85.0
LANE_TIMEOUT_SECONDS=120
SELF_CONFORMANCE_MIN=90.0

# Agents (S10-S12) — they research, they never decide
AGENTS_ENABLED=true
AGENT_MAX_HOPS=3
AGENT_BATCH_SIZE=50
AGENT_MIN_CONFIDENCE=0.6

# Enrichment feeds (S10)
NVD_API_KEY=
KB_SYNC_CRON=0 3 * * *

# Retention
SUBMISSION_RETENTION_DAYS=1095

# --- narrative drafting (RAG) ------------------------------------------------
# Off by default. With it off, assessment sections restate the engine's findings
# plainly and are marked undrafted — correct information in flat prose. Turning
# it on buys better wording and nothing else: every verdict, figure and clause
# still comes from the scoring engine, and a draft asserting anything it was not
# supplied is refused rather than warned about.
#
# Needs a real ANTHROPIC_API_KEY (recognised by its `sk-ant-` prefix, so a
# placeholder cannot produce a live call from a test run) and the optional extra:
#   uv sync --extra llm
NARRATIVE_ENABLED=false
NARRATIVE_MODEL=claude-opus-5
NARRATIVE_EFFORT=medium
NARRATIVE_MAX_TOKENS=8000
