            "title": "Filename"
          },
          "format": {
            "enum": [
              "CycloneDX",
              "SPDX"
            ],
            "title": "Format",
            "type": "string"
          },
          "lane": {
            "description": "Which BOM facet this document is. Declared by the caller, never guessed from the payload: a mis-sniffed format scores the wrong catalogue.",
            "enum": [
              "sbom",
              "cbom",
              "qbom",
              "aibom",
              "hbom"
            ],
            "title": "Lane",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "description": "The BOM document itself. Bounded by MAX_BOM_MB and rejected at the edge before it is read into memory.",
            "title": "Payload",
            "type": "object"
          },
          "spec_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "1.6"
            ],
            "title": "Spec Version"
          }
        },
        "required": [
          "lane",
          "format",
          "payload"
        ],
        "title": "DocumentIn",
        "type": "object"
      },
